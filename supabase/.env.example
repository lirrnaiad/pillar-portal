# Google sign-in for local Supabase Auth (Story 2.1). Copy this file to
# supabase/.env.local (git-ignored, never committed) and fill in a development
# OAuth client from Google Cloud Console: APIs & Services > Credentials >
# Create credentials > OAuth client ID > Web application, with the authorized
# redirect URI http://127.0.0.1:54321/auth/v1/callback. supabase/config.toml
# reads both through env(); restart `pnpm exec supabase start` after a change.
# Never put these in the Next.js env (.env.local at the repo root).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-client-secret

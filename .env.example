NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase (`pnpm exec supabase start`). The key is the CLI's fixed demo
# publishable key, the same on every machine, and works only against the
# local stack. `pnpm exec supabase status -o env` prints the current local
# values (API_URL and PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Prototype persona sign-in on /login (AD-7). It may be on only against the
# local stack or the staging project; the server refuses to start otherwise.
# The password is the one supabase/seed.sql gives the local persona users, so
# the two must match. Staging's is generated and set on Vercel, never here.
PROTOTYPE_PERSONAS=true
PROTOTYPE_PERSONA_PASSWORD=local-persona-password
